# ==========================================
# PEBLO TV — ENVIRONMENT CONFIGURATION
# ==========================================

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=peblo_tv
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/peblo_tv

# Local Disk Storage & Seed Directories
STORAGE_DIR=./storage
SEED_DATA_DIR=./seed_data

# Backend Authentication & Security
SECRET_KEY=super-secret-peblo-admin-key-2026

# Server Ports
API_PORT=8000
CMS_PORT=3000
VIEWER_PORT=3001

# ==========================================
# PRODUCTION SECRET MANAGEMENT ADVICE
# ==========================================
# DO NOT commit .env files containing real secrets to version control.
# In a real production deployment:
# 1. Store database credentials, API secret keys, and storage access tokens
#    in a dedicated secret manager such as AWS Secrets Manager, HashiCorp Vault,
#    or GCP Secret Manager.
# 2. Inject environment variables dynamically into containers at runtime
#    using Kubernetes Secret resources, AWS ECS Task Definitions with AWS Secrets Manager
#    references, or Docker Swarm secrets.
# 3. Restrict access to database credentials using IAM database authentication or
#    short-lived rotated credentials.
